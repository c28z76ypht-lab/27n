{
  "trailingSlash": true,
  "redirects": [
    { "source": "/", "destination": "/pt/", "permanent": true },
    { "source": "/index.html", "destination": "/en/", "permanent": true },
    { "source": "/en", "destination": "/en/", "permanent": true },
    { "source": "/agencia-shopify", "destination": "/pt/agencia-shopify/", "permanent": true },
    { "source": "/agencia-shopify/", "destination": "/pt/agencia-shopify/", "permanent": true },
    { "source": "/migracao-shopify", "destination": "/pt/migracao-shopify/", "permanent": true },
    { "source": "/migracao-shopify/", "destination": "/pt/migracao-shopify/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(favicon.ico|favicon.svg|robots.txt|sitemap.xml|site.webmanifest)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
